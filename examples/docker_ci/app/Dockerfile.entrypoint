# ENTRYPOINT-скрипт + CMD: скрипт готує середовище і запускає те, що передано в CMD.
#   docker build -f Dockerfile.entrypoint -t part10-ep-exec .
#   docker build -f Dockerfile.entrypoint --build-arg SCRIPT=entrypoint-noexec.sh -t part10-ep-noexec .
FROM part10-slim
ARG SCRIPT=entrypoint.sh
COPY --chmod=755 ${SCRIPT} /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
